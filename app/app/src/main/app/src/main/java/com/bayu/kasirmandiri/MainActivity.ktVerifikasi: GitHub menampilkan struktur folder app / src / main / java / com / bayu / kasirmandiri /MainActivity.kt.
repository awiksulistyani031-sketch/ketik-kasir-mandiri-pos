    private val adminWaNumber = "6285148360244"
    private val bankInfo = "MANDIRI 1850004479140 a.n. Bayu Rahadian"

    private val daftarProduk = mutableListOf<Produk>()
    private val keranjang = mutableListOf<ItemKeranjang>()
