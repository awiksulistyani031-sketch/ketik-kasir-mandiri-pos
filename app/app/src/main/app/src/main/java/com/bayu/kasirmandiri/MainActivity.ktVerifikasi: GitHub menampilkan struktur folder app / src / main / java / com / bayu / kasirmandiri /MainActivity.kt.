    private fun ensureDeviceBinding() {
        var devId = prefs.getString("locked_device_id", null)
        if (devId == null) {
            val raw = "${Build.MANUFACTURER}|${Build.MODEL}|${UUID.randomUUID()}"
            val hash = abs(raw.hashCode()).toString(16).uppercase(Locale.ROOT).padStart(8, '0')
            devId = "HP-$hash"
            prefs.edit().putString("locked_device_id", devId).apply()
        }
    }

    private fun getDeviceId(): String = prefs.getString("locked_device_id", "HP-UNKNOWN") ?: "HP-UNKNOWN"

    private fun getEmergencyCodeForDevice(): String {
        val clean = getDeviceId().replace("-", "")
        val tail = clean.takeLast(6)
        val checksum = abs((tail + "MANDIRI20K").hashCode()) % 900 + 100
        return "DRT-$tail-$checksum"
    }

    private fun ensureDefaultPasswords() {
        if (!prefs.contains("pin_admin")) {
            prefs.edit()
                .putString("pin_admin", "1234")
                .putString("pin_kasir", "0000")
                .putString("nama_toko", "TOKO MANDIRI 58MM")
                .putString("alamat_toko", "Jl. Utama No. 1")
                .putString("printer_mac", "")
                .putLong("active_until_ms", 0L)
                .putLong("unique_amount", generateUniqueAmount())
                .apply()
        }
    }

    private fun generateUniqueAmount(): Long {
        val code = (101..899).random()
        return 20000L + code
    }

    private fun isLicenseActive(): Boolean {
        val banned = prefs.getBoolean("account_banned", false)
        if (banned) return false
        val until = prefs.getLong("active_until_ms", 0L)
        return System.currentTimeMillis() < until
    }

    private fun extendLicense30Days() {
        val now = System.currentTimeMillis()
        val currentUntil = prefs.getLong("active_until_ms", 0L)
        val baseTime = if (currentUntil > now) currentUntil else now
        val thirtyDaysMs = 30L * 24L * 60L * 60L * 1000L
        prefs.edit()
            .putLong("active_until_ms", baseTime + thirtyDaysMs)
            .putLong("unique_amount", generateUniqueAmount())
            .apply()
    }

    private fun loadAllData() {
        daftarProduk.clear()
        val prodJson = prefs.getString("data_produk", "[]") ?: "[]"
        val prodArr = JSONArray(prodJson)
        for (i in 0 until prodArr.length()) {
            val obj = prodArr.getJSONObject(i)
            daftarProduk.add(
                Produk(
                    id = obj.getString("id"),
                    nama = obj.getString("nama"),
                    modal = obj.getLong("modal"),
                    harga = obj.getLong("harga"),
                    stok = obj.getInt("stok")
                )
            )
        }
        if (daftarProduk.isEmpty()) {
            daftarProduk.add(Produk("P1", "Kopi Sachet", 2000, 4000, 25))
            daftarProduk.add(Produk("P2", "Air Mineral 600ml", 2000, 3500, 30))
            saveProduk()
        }

        daftarTransaksi.clear()
        val trxJson = prefs.getString("data_transaksi", "[]") ?: "[]"
        val trxArr = JSONArray(trxJson)
        for (i in 0 until trxArr.length()) {
            val obj = trxArr.getJSONObject(i)
            daftarTransaksi.add(
                Transaksi(
                    noNota = obj.getString("noNota"),
                    tanggal = obj.getString("tanggal"),
                    kasirRole = obj.getString("kasirRole"),
                    total = obj.getLong("total"),
                    laba = obj.getLong("laba"),
                    bayar = obj.getLong("bayar"),
                    kembali = obj.getLong("kembali"),
                    ringkasanItem = obj.getString("ringkasanItem")
                )
            )
        }
        activeUniqueAmount = prefs.getLong("unique_amount", generateUniqueAmount())
    }

    private fun saveProduk() {
        val arr = JSONArray()
        daftarProduk.forEach { p ->
            val obj = JSONObject()
            obj.put("id", p.id)
            obj.put("nama", p.nama)
            obj.put("modal", p.modal)
            obj.put("harga", p.harga)
            obj.put("stok", p.stok)
            arr.put(obj)
        }
        prefs.edit().putString("data_produk", arr.toString()).apply()
    }

    private fun saveTransaksi() {
        val arr = JSONArray()
        daftarTransaksi.forEach { t ->
            val obj = JSONObject()
            obj.put("noNota", t.noNota)
            obj.put("tanggal", t.tanggal)
            obj.put("kasirRole", t.kasirRole)
            obj.put("total", t.total)
            obj.put("laba", t.laba)
            obj.put("bayar", t.bayar)
            obj.put("kembali", t.kembali)
            obj.put("ringkasanItem", t.ringkasanItem)
            arr.put(obj)
        }
        prefs.edit().putString("data_transaksi", arr.toString()).apply()
    }

    private fun formatRp(amount: Long): String {
        val nf = NumberFormat.getNumberInstance(Locale("id", "ID"))
        return "Rp ${nf.format(amount)}"
    }

    private fun nowString(): String {
        val sdf = SimpleDateFormat("yyyy-MM-dd HH:mm", Locale.getDefault())
        return sdf.format(Date())
    }

    private fun todayDateOnly(): String {
        val sdf = SimpleDateFormat("yyyy-MM-dd", Locale.getDefault())
        return sdf.format(Date())
    }

    private fun requestBluetoothPermissionsIfNeeded() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
            val needed = mutableListOf<String>()
            if (ContextCompat.checkSelfPermission(this, Manifest.permission.BLUETOOTH_CONNECT) != PackageManager.PERMISSION_GRANTED) {
                needed.add(Manifest.permission.BLUETOOTH_CONNECT)
            }
            if (ContextCompat.checkSelfPermission(this, Manifest.permission.BLUETOOTH_SCAN) != PackageManager.PERMISSION_GRANTED) {
                needed.add(Manifest.permission.BLUETOOTH_SCAN)
            }
            if (needed.isNotEmpty()) {
                ActivityCompat.requestPermissions(this, needed.toTypedArray(), 101)
            }
        }
    }

    private fun buildBaseLayout() {
        val scroll = ScrollView(this).apply {
            setBackgroundColor(Color.parseColor("#F4F6F8"))
            layoutParams = LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT,
                LinearLayout.LayoutParams.MATCH_PARENT
            )
        }

        rootContainer = LinearLayout(this).apply {
