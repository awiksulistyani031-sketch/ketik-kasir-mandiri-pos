    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        ensureDeviceBinding()
        ensureDefaultPasswords()
        loadAllData()
        requestBluetoothPermissionsIfNeeded()

        buildBaseLayout()
        refreshScreen()
