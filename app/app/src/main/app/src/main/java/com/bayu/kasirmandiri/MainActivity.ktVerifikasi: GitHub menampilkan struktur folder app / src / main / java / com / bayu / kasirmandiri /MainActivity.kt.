            setPadding(24, 20, 24, 20)
        }

        contentContainer = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(0, 16, 0, 0)
        }

        rootContainer.addView(tvHeaderInfo)
        rootContainer.addView(contentContainer)
        scroll.addView(rootContainer)
        setContentView(scroll)
    }

    private fun refreshScreen() {
        contentContainer.removeAllViews()
        val toko = prefs.getString("nama_toko", "TOKO MANDIRI 58MM") ?: "TOKO MANDIRI 58MM"
        val devId = getDeviceId()

        if (prefs.getBoolean("account_banned", false)) {
            tvHeaderInfo.text = "$toko | $devId | TERBLOKIR"
            renderBannedScreen()
            return
        }

        if (!isLicenseActive()) {
            tvHeaderInfo.text = "$toko | $devId | LISENSI NONAKTIF"
            renderActivationScreen()
            return
        }

        if (currentRole.isEmpty()) {
            val sdf = SimpleDateFormat("yyyy-MM-dd", Locale.getDefault())
            val expText = sdf.format(Date(prefs.getLong("active_until_ms", 0L)))
            tvHeaderInfo.text = "$toko | $devId | Aktif s/d $expText"
            renderLoginScreen()
            return
        }

        tvHeaderInfo.text = "$toko | Peran: $currentRole | $devId"
        if (currentRole == "ADMIN") {
            renderAdminMenu()
        } else {
            renderKasirMenu()
        }
    }

    private fun renderBannedScreen() {
        contentContainer.addView(makeCardWarning(
