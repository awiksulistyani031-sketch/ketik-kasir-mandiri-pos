                prefs.edit()
                    .putString("nama_toko", etToko.text.toString().trim().ifEmpty { "TOKO MANDIRI 58MM" })
                    .putString("pin_admin", etPinAdmin.text.toString().trim().ifEmpty { "1234" })
                    .putString("pin_kasir", etPinKasir.text.toString().trim().ifEmpty { "0000" })
                    .putString("printer_mac", etPrinterMac.text.toString().trim())
                    .apply()
                Toast.makeText(this@MainActivity, "Pengaturan disimpan", Toast.LENGTH_SHORT).show()
                refreshScreen()
            }
        }

        contentContainer.addView(etToko)
        contentContainer.addView(etPinAdmin)
        contentContainer.addView(etPinKasir)
        contentContainer.addView(etPrinterMac)
        contentContainer.addView(btnSimpanSetelan)

        val etBackup = EditText(this).apply {
            hint = "Teks Backup / Paste Teks Restore di sini"
            minLines = 3
        }
        val btnExport = Button(this).apply {
            text = "Buat Teks Backup Data"
            setOnClickListener {
                val backupObj = JSONObject().apply {
                    put("produk", prefs.getString("data_produk", "[]"))
                    put("transaksi", prefs.getString("data_transaksi", "[]"))
                }
                etBackup.setText(backupObj.toString())
                Toast.makeText(this@MainActivity, "Teks backup siap disalin", Toast.LENGTH_SHORT).show()
            }
        }
        val btnImport = Button(this).apply {
            text = "Pulihkan Data dari Teks Backup"
            setOnClickListener {
                try {
                    val raw = etBackup.text.toString().trim()
                    val obj = JSONObject(raw)
                    prefs.edit()
                        .putString("data_produk", obj.optString("produk", "[]"))
                        .putString("data_transaksi", obj.optString("transaksi", "[]"))
                        .apply()
                    loadAllData()
                    Toast.makeText(this@MainActivity, "Data berhasil dipulihkan", Toast.LENGTH_SHORT).show()
                    refreshScreen()
                } catch (e: Exception) {
                    Toast.makeText(this@MainActivity, "Format backup tidak valid", Toast.LENGTH_SHORT).show()
                }
            }
        }
        contentContainer.addView(btnExport)
        contentContainer.addView(etBackup)
        contentContainer.addView(btnImport)
    }

    private fun buildReceipt58mm(trx: Transaksi): String {
        val width = 32
        val toko = (prefs.getString("nama_toko", "TOKO MANDIRI 58MM") ?: "TOKO MANDIRI 58MM").take(width)
        val sb = StringBuilder()
        sb.appendLine(centerLine(toko, width))
        sb.appendLine(centerLine("STRUK PEMBAYARAN", width))
        sb.appendLine("-".repeat(width))
        sb.appendLine("Nota : ${trx.noNota}".take(width))
        sb.appendLine("Tgl  : ${trx.tanggal}".take(width))
        sb.appendLine("-".repeat(width))
        trx.ringkasanItem.split("; ").forEach { part ->
            sb.appendLine(part.take(width))
        }
        sb.appendLine("-".repeat(width))
        sb.appendLine("TOTAL   : ${formatRp(trx.total)}".take(width))
        sb.appendLine("BAYAR   : ${formatRp(trx.bayar)}".take(width))
        sb.appendLine("KEMBALI : ${formatRp(trx.kembali)}".take(width))
        sb.appendLine("-".repeat(width))
        sb.appendLine(centerLine("Terima kasih telah belanja", width))
        sb.appendLine("\n\n")
        return sb.toString()
    }

    private fun centerLine(text: String, width: Int): String {
        if (text.length >= width) return text.take(width)
        val pad = (width - text.length) / 2
        return " ".repeat(pad) + text
    }

    private fun printBluetoothText(receiptText: String) {
        val mac = prefs.getString("printer_mac", "")?.trim() ?: ""
        if (mac.isEmpty()) return
        try {
            val btManager = getSystemService(Context.BLUETOOTH_SERVICE) as BluetoothManager
            val adapter: BluetoothAdapter? = btManager.adapter
            if (adapter == null || !adapter.isEnabled) return
            val device = adapter.getRemoteDevice(mac)
            val sppUuid = UUID.fromString("00001101-0000-1000-8000-00805F9B34FB")
            val socket = device.createRfcommSocketToServiceRecord(sppUuid)
            socket.connect()
            socket.outputStream.write(receiptText.toByteArray(Charsets.UTF_8))
            socket.outputStream.flush()
            socket.close()
        } catch (_: Exception) {
            Toast.makeText(this, "Struk tersimpan. Cek koneksi printer Bluetooth 58mm.", Toast.LENGTH_SHORT).show()
        }
    }

