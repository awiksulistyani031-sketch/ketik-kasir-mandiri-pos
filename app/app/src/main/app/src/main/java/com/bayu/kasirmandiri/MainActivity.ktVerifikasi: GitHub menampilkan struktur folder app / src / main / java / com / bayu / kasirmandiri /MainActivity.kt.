        ))
    }

    private fun renderActivationScreen() {
        activeUniqueAmount = prefs.getLong("unique_amount", generateUniqueAmount())
        val isFirstTime = prefs.getLong("active_until_ms", 0L) == 0L
        val modeLabel = if (isFirstTime) "Beli & Aktivasi Awal (Rp 20.000)" else "Perpanjangan Bulanan (Rp 20.000/bulan)"

        contentContainer.addView(makeTitle("Aktivasi & Langganan Aplikasi"))
        contentContainer.addView(makeInfoBox(
            "Skema: $modeLabel\n" +
                "Transfer ke: $bankInfo\n" +
                "Nominal Unik Wajib: ${formatRp(activeUniqueAmount)}\n" +
                "ID Perangkat Terkunci: ${getDeviceId()}"
        ))

        contentContainer.addView(makeCardWarning(
            "PERINGATAN KERAS:\nMengirim bukti transfer palsu, bukti lama, atau data yang salah akan otomatis menonaktifkan akun dan mengunci aplikasi."
        ))

        val etTanggal = EditText(this).apply {
            hint = "Tanggal Transfer (YYYY-MM-DD), cth: ${todayDateOnly()}"
            setText(todayDateOnly())
        }
        val etNominal = EditText(this).apply {
            hint = "Nominal Transfer Terbaca (cth: $activeUniqueAmount)"
            inputType = InputType.TYPE_CLASS_NUMBER
            setText(activeUniqueAmount.toString())
        }
        val etRef = EditText(this).apply {
            hint = "Kode Unik / No. Referensi Bukti"
        }

        contentContainer.addView(makeLabel("Tanggal Bukti Transfer:"))
        contentContainer.addView(etTanggal)
        contentContainer.addView(makeLabel("Nominal Transfer (Sesuai Tagihan Unik):"))
        contentContainer.addView(etNominal)
        contentContainer.addView(makeLabel("Kode Unik / No. Referensi:"))
        contentContainer.addView(etRef)

        val btnVerifikasiAktifkan = Button(this).apply {
            text = "Verifikasi Bukti & Aktifkan 30 Hari"
            setBackgroundColor(Color.parseColor("#16A34A"))
            setTextColor(Color.WHITE)
            setOnClickListener {
                val tgl = etTanggal.text.toString().trim()
                val nomStr = etNominal.text.toString().trim()
                val refCode = etRef.text.toString().trim()
                val nom = nomStr.toLongOrNull() ?: -1L

                if (tgl.length < 8 || nom <= 0 || refCode.isEmpty()) {
                    prefs.edit().putBoolean("account_banned", true).apply()
                    refreshScreen()
                    return@setOnClickListener
                }

                if (nom != activeUniqueAmount || tgl != todayDateOnly()) {
                    prefs.edit().putBoolean("account_banned", true).apply()
                    refreshScreen()
                    return@setOnClickListener
                }

                val usedKey = "$tgl|$nom"
                val usedSet = prefs.getStringSet("used_proof_keys", mutableSetOf()) ?: mutableSetOf()
                if (usedSet.contains(usedKey)) {
                    Toast.makeText(this@MainActivity, "Bukti dengan tanggal dan nominal ini sudah pernah dipakai!", Toast.LENGTH_LONG).show()
                    return@setOnClickListener
                }

                val updatedSet = usedSet.toMutableSet().apply { add(usedKey) }
                prefs.edit().putStringSet("used_proof_keys", updatedSet).apply()
                extendLicense30Days()
                Toast.makeText(this@MainActivity, "Aktivasi berhasil! Masa aktif 30 hari berjalan.", Toast.LENGTH_LONG).show()
                refreshScreen()
            }
        }

        val btnKirimWa = Button(this).apply {
            text = "Kirim Bukti ke WhatsApp Admin (085148360244)"
            setBackgroundColor(Color.parseColor("#0284C7"))
            setTextColor(Color.WHITE)
            setOnClickListener {
                val pesan = "Halo Admin, saya ingin konfirmasi pembayaran aplikasi kasir.\n" +
                    "Nama Toko: ${prefs.getString("nama_toko", "-")}\n" +
                    "ID Perangkat: ${getDeviceId()}\n" +
                    "Nominal Unik: ${formatRp(activeUniqueAmount)}\n" +
                    "Tanggal: ${etTanggal.text.toString().trim()}\n" +
                    "Tujuan: $bankInfo\n" +
                    "(Saya melampirkan foto bukti transfer pada chat ini.)"
                val uri = Uri.parse("https://wa.me/$adminWaNumber?text=${Uri.encode(pesan)}")
                startActivity(Intent(Intent.ACTION_VIEW, uri))
            }
        }

        val etKodeDarurat = EditText(this).apply {
            hint = "Masukkan Kode Darurat Admin (jika ganti HP/data hilang)"
        }
        val btnKodeDarurat = Button(this).apply {
            text = "Gunakan Kode Darurat Admin"
            setOnClickListener {
                val inputKode = etKodeDarurat.text.toString().trim().uppercase(Locale.ROOT)
                if (inputKode == getEmergencyCodeForDevice()) {
                    prefs.edit().putBoolean("account_banned", false).apply()
                    extendLicense30Days()
                    Toast.makeText(this@MainActivity, "Kode darurat diterima. Aplikasi aktif 30 hari.", Toast.LENGTH_LONG).show()
                    refreshScreen()
                } else {
                    Toast.makeText(this@MainActivity, "Kode darurat tidak valid.", Toast.LENGTH_SHORT).show()
                }
            }
        }

        contentContainer.addView(btnVerifikasiAktifkan)
        contentContainer.addView(btnKirimWa)
        contentContainer.addView(makeLabel("Pemulihan Perangkat (Kode Darurat Admin):"))
        contentContainer.addView(etKodeDarurat)
        contentContainer.addView(btnKodeDarurat)
    }

    private fun renderLoginScreen() {
        contentContainer.addView(makeTitle("Masuk Aplikasi Kasir"))
        contentContainer.addView(makeInfoBox("Pilih peran dan masukkan sandi masing-masing.\nDefault Admin: 1234 | Default Kasir: 0000"))

        val rgRole = RadioGroup(this).apply {
            orientation = RadioGroup.HORIZONTAL
        }
        val rbKasir = RadioButton(this).apply {
            id = View.generateViewId()
            text = "KASIR"
            isChecked = true
        }
        val rbAdmin = RadioButton(this).apply {
            id = View.generateViewId()
            text = "ADMIN"
        }
        rgRole.addView(rbKasir)
        rgRole.addView(rbAdmin)

        val etPin = EditText(this).apply {
            hint = "Masukkan Sandi / PIN"
            inputType = InputType.TYPE_CLASS_NUMBER or InputType.TYPE_NUMBER_VARIATION_PASSWORD
        }

        val btnMasuk = Button(this).apply {
            text = "Masuk"
            setBackgroundColor(Color.parseColor("#1E293B"))
            setTextColor(Color.WHITE)
            setOnClickListener {
                val chosenAdmin = rgRole.checkedRadioButtonId == rbAdmin.id
                val pinInput = etPin.text.toString().trim()
                val savedAdminPin = prefs.getString("pin_admin", "1234")
                val savedKasirPin = prefs.getString("pin_kasir", "0000")

                if (chosenAdmin && pinInput == savedAdminPin) {
                    currentRole = "ADMIN"
                    refreshScreen()
                } else if (!chosenAdmin && pinInput == savedKasirPin) {
                    currentRole = "KASIR"
                    refreshScreen()
                } else {
                    Toast.makeText(this@MainActivity, "Sandi salah!", Toast.LENGTH_SHORT).show()
                }
            }
        }

        contentContainer.addView(rgRole)
        contentContainer.addView(etPin)
        contentContainer.addView(btnMasuk)
    }

    private fun renderKasirMenu() {
        contentContainer.addView(makeTitle("Menu Kasir Penjualan"))

        val btnLogout = Button(this).apply {
            text = "Kunci / Ganti Akun"
            setOnClickListener {
                currentRole = ""
                refreshScreen()
            }
        }
        contentContainer.addView(btnLogout)

        contentContainer.addView(makeLabel("Daftar Produk (Klik untuk tambah ke keranjang):"))
        daftarProduk.forEach { produk ->
            val btnProd = Button(this).apply {
                text = "${produk.nama} | ${formatRp(produk.harga)} | Stok: ${produk.stok}"
                isEnabled = produk.stok > 0
                setOnClickListener {
                    val existing = keranjang.find { it.produk.id == produk.id }
                    if (existing != null) {
                        if (existing.qty < produk.stok) existing.qty += 1
                    } else {
                        keranjang.add(ItemKeranjang(produk, 1))
                    }
                    refreshScreen()
                }
            }
            contentContainer.addView(btnProd)
        }

        val totalBelanja = keranjang.sumOf { it.produk.harga * it.qty }
        val ringkasan = if (keranjang.isEmpty()) {
            "Keranjang kosong"
        } else {
            keranjang.joinToString("\n") { "${it.produk.nama} x${it.qty} = ${formatRp(it.produk.harga * it.qty)}" }
        }

        contentContainer.addView(makeInfoBox("Keranjang:\n$ringkasan\n\nTotal Tagihan: ${formatRp(totalBelanja)}"))

        val etBayar = EditText(this).apply {
            hint = "Uang Diterima (Rp)"
            inputType = InputType.TYPE_CLASS_NUMBER
        }

        val btnProsesBayar = Button(this).apply {
            text = "Simpan Transaksi & Cetak Struk 58mm"
            setBackgroundColor(Color.parseColor("#16A34A"))
            setTextColor(Color.WHITE)
            setOnClickListener {
                if (keranjang.isEmpty()) {
                    Toast.makeText(this@MainActivity, "Keranjang masih kosong", Toast.LENGTH_SHORT).show()
                    return@setOnClickListener
                }
                val bayar = etBayar.text.toString().trim().toLongOrNull() ?: 0L
                if (bayar < totalBelanja) {
                    Toast.makeText(this@MainActivity, "Uang bayar kurang dari total tagihan", Toast.LENGTH_SHORT).show()
                    return@setOnClickListener
                }
                val kembali = bayar - totalBelanja
                var totalLaba = 0L
                val itemLines = mutableListOf<String>()

                keranjang.forEach { item ->
                    item.produk.stok -= item.qty
                    val labaItem = (item.produk.harga - item.produk.modal) * item.qty
                    totalLaba += labaItem
                    itemLines.add("${item.produk.nama} ${item.qty}x${item.produk.harga}=${item.produk.harga * item.qty}")
                }

                val noNota = "INV-${System.currentTimeMillis().toString().takeLast(6)}"
                val trx = Transaksi(
                    noNota = noNota,
                    tanggal = nowString(),
                    kasirRole = currentRole,
                    total = totalBelanja,
                    laba = totalLaba,
                    bayar = bayar,
                    kembali = kembali,
                    ringkasanItem = itemLines.joinToString("; ")
                )
                daftarTransaksi.add(0, trx)
                saveProduk()
                saveTransaksi()
                keranjang.clear()

                val struk58 = buildReceipt58mm(trx)
                printBluetoothText(struk58)
                showReceiptDialog(struk58)
                refreshScreen()
            }
        }

        contentContainer.addView(etBayar)
        contentContainer.addView(btnProsesBayar)
    }

